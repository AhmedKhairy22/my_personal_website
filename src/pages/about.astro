---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import InterestChips from '../components/InterestChips.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { SITE, TOOLS } from '../data/site';
import photo from '../assets/me.jpeg';
---

<BaseLayout title="About" description={`About ${SITE.name}`}>
  <!-- Intro + photo -->
  <section class="grid gap-10 sm:grid-cols-[minmax(0,1fr)_220px] sm:items-start">
    <div>
      <p class="font-mono text-xs uppercase tracking-widest text-accent">About me</p>
      <h1 class="mt-2 font-display text-4xl font-bold leading-tight tracking-tight">
        I like figuring out how things work by <span class="highlight">building them</span>.
      </h1>

      <div class="mt-8 space-y-5 text-lg leading-relaxed text-muted">
        <p>
          I'm <span class="font-medium text-ink">Ahmed</span>, and I have a growing interest in
          software engineering, science, and the ways different fields intersect. I enjoy learning
          how things work, experimenting with ideas, and building things from scratch.
        </p>
        <p>
          My curiosity keeps drawing me deeper into the world of programming and software engineering. 
          I enjoy exploring new concepts, understanding the ideas behind them, 
          and turning what I learn into something tangible. 
          I'm also drawn to open source and the opportunity to learn from and contribute to a wider community.
        </p>
        <p>
          Outside of technology, I enjoy reading, exploring philosophy and history, playing chess,
          and discovering new perspectives through conversations and experiences.
        </p>
        <p>
          This website is my little corner of the internet: a place to document what I'm learning,
          share things I'm building, write about ideas that interest me, and occasionally explore
          things beyond my usual fields.
        </p>
      </div>
    </div>

    <figure class="order-first w-48 sm:order-none sm:w-full">
      <div class="relative">
        <div class="absolute inset-0 -rotate-3 rounded-3xl bg-accent"></div>
        <Image
          src={photo}
          alt={`Photo of ${SITE.name}`}
          width={600}
          loading="eager"
          class="relative aspect-[4/5] w-full rotate-2 rounded-3xl object-cover object-[50%_20%] ring-4 ring-card transition duration-300 hover:rotate-0"
        />
      </div>
      <figcaption class="mt-4 text-center text-sm text-muted">
        Me, right after my code worked on the first try.
      </figcaption>
    </figure>
  </section>

  <!-- Interests -->
  <section class="mt-20">
    <SectionTitle eyebrow="Interests" title="Things I'm into" />
    <InterestChips />
  </section>

  <!-- Tools -->
  <section class="mt-20">
    <SectionTitle eyebrow="Toolbox" title="What I build with" />
    <ul class="flex flex-wrap gap-2">
      {TOOLS.map((tool) => (
        <li class="rounded-full bg-sea-soft px-3 py-1 text-sm font-medium text-sea">{tool}</li>
      ))}
    </ul>
  </section>

  <!-- Contact -->
  <section class="mt-20 rounded-3xl border border-line bg-card p-8 text-center">
    <h2 class="font-display text-2xl font-semibold">Say hello</h2>
    <p class="mx-auto mt-2 max-w-md text-muted">
      Want to talk about code, open source, books, or anything in between? I'd love to hear from you.
    </p>
    <a
      href={`mailto:${SITE.email}`}
      class="mt-6 inline-block rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
    >
      Send me an email
    </a>
    <div class="mt-6 flex justify-center">
      <SocialLinks />
    </div>
  </section>
</BaseLayout>