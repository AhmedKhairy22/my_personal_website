---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostItem from '../components/PostItem.astro';
import InterestChips from '../components/InterestChips.astro';
import { SITE } from '../data/site';
import { projects } from '../data/projects';
import { getPosts } from '../lib/posts';
import photo from '../assets/me.jpeg';

const featuredProjects = projects.filter((p) => p.featured).slice(0, 4);
const recentPosts = (await getPosts()).slice(0, 3);
---

<BaseLayout>
  <!-- Hero -->
  <section class="grid items-center gap-10 sm:grid-cols-[1fr_auto]">
    <div>
      <p class="inline-flex items-center gap-2 rounded-full border border-line bg-card px-3 py-1 text-xs text-muted">
        <span class="h-1.5 w-1.5 rounded-full bg-sea"></span>
        {SITE.location} · learning in public
      </p>
      <h1 class="mt-5 font-display text-4xl font-bold leading-tight tracking-tight sm:text-5xl">
        Hi, I'm <span class="text-accent">{SITE.firstName}</span>.
      </h1>
      <p class="mt-3 text-xl font-medium">
        <span class="highlight">{SITE.tagline}</span>
      </p>
      <p class="mt-4 max-w-lg leading-relaxed text-muted">{SITE.intro}</p>

      <div class="mt-7 flex flex-wrap gap-3 text-sm font-medium">
        <a
          href="/projects"
          class="rounded-full bg-accent px-5 py-2.5 text-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
        >
          See what I've built
        </a>
        <a
          href="/blog"
          class="rounded-full border border-line bg-card px-5 py-2.5 transition hover:-translate-y-0.5 hover:border-accent"
        >
          Read the blog
        </a>
      </div>
    </div>

    <div class="relative order-first w-40 sm:order-none sm:w-52">
      <div class="absolute inset-0 translate-x-3 translate-y-3 rotate-3 rounded-3xl bg-sun"></div>
      <Image
        src={photo}
        alt={`Photo of ${SITE.name}`}
        width={480}
        loading="eager"
        class="relative aspect-square w-full rounded-3xl object-cover object-[50%_25%] ring-4 ring-card transition duration-300 hover:-rotate-3"
      />
    </div>
  </section>

  <!-- Interests -->
  <section class="mt-12">
    <InterestChips />
  </section>

  <!-- Projects -->
  <section class="mt-20">
    <SectionTitle eyebrow="Projects" title="Things I've built" href="/projects" />
    <div class="grid gap-4 sm:grid-cols-2">
      {featuredProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <!-- Writing -->
  <section class="mt-20">
    <SectionTitle eyebrow="Journal" title="Latest writing" href="/blog" />
    {recentPosts.length > 0 ? (
      <ul class="divide-y divide-line">
        {recentPosts.map((post) => <PostItem post={post} />)}
      </ul>
    ) : (
      <p class="text-muted">Nothing here yet. The first post is still compiling.</p>
    )}
  </section>
</BaseLayout>