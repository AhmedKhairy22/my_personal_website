---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostItem from '../../components/PostItem.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
---

<BaseLayout title="Blog" description="Notes, ideas, and things I've learned.">
  <p class="font-mono text-xs uppercase tracking-widest text-accent">Journal</p>
  <h1 class="mt-2 font-display text-4xl font-bold tracking-tight">Notes & ideas</h1>
  <p class="mt-3 max-w-lg text-muted">
    What I'm learning, what I'm building, and ideas I want to think through in writing.
  </p>

  {posts.length > 0 ? (
    <ul class="mt-10 divide-y divide-line">
      {posts.map((post) => <PostItem post={post} />)}
    </ul>
  ) : (
    <p class="mt-10 text-muted">Nothing here yet. The first post is still compiling.</p>
  )}
</BaseLayout>