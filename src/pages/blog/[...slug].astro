---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getPosts } from '../../lib/posts';
import { SITE } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <a href="/blog" class="group text-sm font-medium text-muted transition-colors hover:text-accent">
    <span class="inline-block transition-transform group-hover:-translate-x-1">←</span> Back to blog
  </a>

  <article class="mt-8">
    <header>
      <p class="font-mono text-xs text-muted">
        <FormattedDate date={post.data.pubDate} />
      </p>
      <h1 class="mt-2 font-display text-4xl font-bold leading-tight tracking-tight">{post.data.title}</h1>
      {post.data.tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-1.5">
          {post.data.tags.map((tag) => (
            <li class="rounded-full bg-sea-soft px-2.5 py-0.5 text-xs font-medium text-sea">{tag}</li>
          ))}
        </ul>
      )}
    </header>

    <div class="prose prose-neutral mt-10 max-w-none dark:prose-invert prose-headings:font-display prose-headings:font-semibold prose-a:text-accent prose-a:no-underline hover:prose-a:underline prose-strong:text-ink prose-li:marker:text-accent">
      <Content />
    </div>
  </article>

  <div class="mt-16 rounded-2xl border border-line bg-card p-6">
   <p class="font-display text-lg font-semibold">Thanks for reading!</p>
    <p class="mt-1 text-sm text-muted">
      Thoughts or corrections? Send me an
      <a href={`mailto:${SITE.email}`} class="font-medium text-accent hover:underline"> email </a>
      or find me on
      <a href="https://x.com/ahmed_kh42" target="_blank" rel="noopener noreferrer" class="font-medium text-accent hover:underline"> X</a>.
    </p>
  </div>
</BaseLayout>