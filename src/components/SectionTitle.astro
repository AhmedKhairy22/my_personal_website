---
interface Props {
  title: string;
  eyebrow?: string;
  href?: string;
  linkText?: string;
}

const { title, eyebrow, href, linkText = 'View all' } = Astro.props;
---

<div class="mb-6 flex items-end justify-between gap-4">
  <div>
    {eyebrow && <p class="font-mono text-xs uppercase tracking-widest text-accent">{eyebrow}</p>}
    <h2 class="mt-1 font-display text-2xl font-semibold">{title}</h2>
  </div>
  {href && (
    <a href={href} class="group shrink-0 text-sm font-medium text-muted transition-colors hover:text-accent">
      {linkText} <span class="inline-block transition-transform group-hover:translate-x-1">→</span>
    </a>
  )}
</div>