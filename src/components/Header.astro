---
import ThemeToggle from './ThemeToggle.astro';
import { NAV_LINKS, SITE } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-line/70 bg-paper/80 backdrop-blur-md">
  <nav class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-6 py-3">
    <a href="/" class="group flex items-center gap-2.5" aria-label="Home">
      <span class="grid h-9 w-9 place-items-center rounded-xl bg-accent text-sm font-bold text-white shadow-sm transition-transform group-hover:-rotate-6">
        AK
      </span>
      <span class="hidden font-display text-lg font-semibold sm:inline">{SITE.name}</span>
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      <ul class="flex items-center gap-1 text-sm">
        {NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'rounded-full px-3 py-1.5 transition-colors',
                isActive(link.href)
                  ? 'bg-accent-soft font-medium text-accent'
                  : 'text-muted hover:bg-card hover:text-ink',
              ]}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>