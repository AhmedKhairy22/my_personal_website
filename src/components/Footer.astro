---
import SocialLinks from './SocialLinks.astro';
import { SITE } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="mt-10 border-t border-line">
  <div class="mx-auto max-w-3xl px-6 py-12">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="font-display text-2xl font-semibold">Let's talk</p>
        <p class="mt-1 text-sm text-muted">Questions, ideas, or a game of chess. My inbox is open.</p>
        <a
          href={`mailto:${SITE.email}`}
          class="mt-3 inline-block text-sm font-medium text-accent underline-offset-4 hover:underline"
        >
          {SITE.email}
        </a>
      </div>
      <SocialLinks />
    </div>

    <p class="mt-10 text-xs text-muted">
      © {year} {SITE.name} · Built with Astro & Tailwind · Works on my machine.
    </p>
  </div>
</footer>