---
import { INTERESTS } from '../data/site';
---

<ul class="flex flex-wrap gap-2">
  {INTERESTS.map((item) => (
    <li class="cursor-default rounded-full border border-line bg-card px-3 py-1 text-sm transition hover:-translate-y-0.5 hover:rotate-1 hover:border-accent hover:text-accent">
      {item}
    </li>
  ))}
</ul>