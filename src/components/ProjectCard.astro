---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="group flex flex-col rounded-2xl border border-line bg-card p-5 transition duration-200 hover:-translate-y-1 hover:border-accent hover:shadow-[5px_5px_0_0_var(--accent)]">
  <div class="flex items-start justify-between gap-4">
    <h3 class="font-display text-lg font-semibold transition-colors group-hover:text-accent">
      {project.title}
    </h3>
    <div class="flex shrink-0 gap-3 pt-1 text-sm font-medium">
      {project.link && (
        <a href={project.link} target="_blank" rel="noopener noreferrer" class="text-muted transition-colors hover:text-accent">
          Live ↗
        </a>
      )}
      {project.repo && (
        <a href={project.repo} target="_blank" rel="noopener noreferrer" class="text-muted transition-colors hover:text-accent">
          Code ↗
        </a>
      )}
    </div>
  </div>

  <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{project.description}</p>

  <ul class="mt-4 flex flex-wrap gap-1.5">
    {project.tags.map((tag) => (
      <li class="rounded-full bg-sea-soft px-2.5 py-0.5 text-xs font-medium text-sea">{tag}</li>
    ))}
  </ul>
</article>